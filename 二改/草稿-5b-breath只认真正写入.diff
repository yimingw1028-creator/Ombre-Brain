+# --- 二改 5b：breath 排序看哪只钟 ---
+# created（默认）：浮现分 = 把这条桶当作"从上次真正写入之后没人碰过"来算的衰减分。
+#   做法是算分前把 last_active 换成"最近一次真正写入的时间"；公式仍是
+#   decay_engine 那一条，重要度、情绪、被想起次数照常算数。
+#   真正写入 = 创建；hold/grow 把新内容并进这条桶；从归档里主动恢复。
+#   被 breath_search 命中（touch）不算。
+# active：直接用衰减分，即 5b 之前的行为。
+# 归档只看 decay_engine 自己的分数，不经过这里，所以续命照样防归档。
+_BREATH_CLOCK_CREATED = "created"
+_BREATH_CLOCK_ACTIVE = "active"
+
+
+def _breath_score_clock(surfacing_cfg: dict) -> str:
+    clock = str(
+        (surfacing_cfg or {}).get("breath_score_clock") or _BREATH_CLOCK_CREATED
+    ).strip().lower()
+    if clock not in (_BREATH_CLOCK_CREATED, _BREATH_CLOCK_ACTIVE):
+        return _BREATH_CLOCK_CREATED
+    return clock
+
+
+def _last_written_at(footprint_snapshot, bucket_id: str) -> str:
+    """足迹里这条桶最近一次"真正写入"的时间；没有或读不到时返回空串。
+
+    只认三种事件：创建（TraceCreated）、hold/grow 合并进来（TraceUpdated 且
+    changed_fields 里有 last_merged_by）、从归档恢复（TraceRestored）。
+    TraceTouched（被搜索命中）和纯元数据修改都不算。
+    """
+    if footprint_snapshot is None:
+        return ""
+    try:
+        events = footprint_snapshot.events_by_trace.get(str(bucket_id), ())
+    except Exception:
+        return ""
+    latest = None
+    latest_raw = ""
+    for event in events:
+        if not isinstance(event, dict):
+            continue
+        event_type = str(event.get("event_type") or "")
+        if event_type == "TraceUpdated":
+            payload = event.get("payload") if isinstance(event.get("payload"), dict) else {}
+            fields = {str(item) for item in payload.get("changed_fields") or []}
+            if "last_merged_by" not in fields:
+                continue
+        elif event_type not in ("TraceCreated", "TraceRestored"):
+            continue
+        raw = str(event.get("recorded_at") or "")
+        try:
+            stamp = parse_iso_datetime(raw)
+        except (ValueError, TypeError):
+            continue
+        if latest is None or stamp > latest:
+            latest, latest_raw = stamp, raw
+    return latest_raw
+
+
+def _surface_score(meta: dict, clock: str, written_at: str = "") -> float:
+    """breath 浮现段排序、采样、显示用的分数。
+
+    written_at：_last_written_at() 给出的时间，比 created 新时才采用。
+    created 缺失时退回原衰减分（这条桶保持旧行为）。不修改传入的 meta。
+    """
+    if clock == _BREATH_CLOCK_CREATED and isinstance(meta, dict):
+        created = meta.get("created")
+        if created:
+            stamp = created
+            if written_at:
+                try:
+                    if parse_iso_datetime(written_at) > parse_iso_datetime(created):
+                        stamp = written_at
+                except (ValueError, TypeError):
+                    stamp = created
+            meta = {**meta, "last_active": stamp}
+    return rt.decay_engine.calculate_score(meta)
+
+
