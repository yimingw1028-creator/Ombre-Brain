+             "payload": {"changed_fields": ["content"]},
+             "recorded_at": "2026-10-20T00:00:00+00:00"},
+            {"trace_id": "p", "event_type": "TraceTouched", "payload": {},
+             "recorded_at": "2026-10-29T00:00:00+00:00"},
+        ]
+    )
